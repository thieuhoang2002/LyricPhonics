# ==============================================================================
# LYRICPHONICS — ENVIRONMENT VARIABLES TEMPLATE
# Copy file này thành .env trên server hoặc cấu hình trực tiếp trên Cloud Dashboard
# ==============================================================================

# 1. DATABASE (PostgreSQL / Neon Cloud)
# Format chuẩn ADO.NET Npgsql:
# Host=...;Port=5432;Database=...;Username=...;Password=...;SSL Mode=Require;Trust Server Certificate=true;
DATABASE_URL=Host=ep-jolly-cherry-azmr8go9-pooler.c-3.ap-southeast-1.aws.neon.tech;Port=5432;Database=neondb;Username=neondb_owner;Password=YOUR_NEON_PASSWORD;SSL Mode=Require;Trust Server Certificate=true;

# 2. AI MODEL APIS
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
GROQ_API_KEY=YOUR_GROQ_API_KEY

# 3. JWT AUTHENTICATION
JWT_SECRET_KEY=YOUR_SUPER_SECRET_KEY_AT_LEAST_32_CHARACTERS_LONG_9032_XYZ!

# 4. ADMIN UNIVERSE (2-LAYER SECURITY)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=YOUR_LAYER1_PASSWORD
ADMIN_MASTER_PASSPHRASE=YOUR_LAYER2_PASSPHRASE
ADMIN_PASSPHRASE_HINT=Your secure passphrase hint here

# 5. BOT PROTECTION (Cloudflare Turnstile)
# Lấy từ Cloudflare Dashboard -> Turnstile
NEXT_PUBLIC_TURNSTILE_SITE_KEY=YOUR_TURNSTILE_SITE_KEY
TURNSTILE_SECRET_KEY=YOUR_TURNSTILE_SECRET_KEY

# 6. CLOUDFLARE R2 OBJECT STORAGE (Lưu trữ file âm thanh / MP3 / MP4 trên mây)
# Lấy từ Cloudflare Dashboard -> R2 -> Manage R2 API Tokens
R2_ACCOUNT_ID=YOUR_CLOUDFLARE_ACCOUNT_ID
R2_ACCESS_KEY_ID=YOUR_R2_ACCESS_KEY_ID
R2_SECRET_ACCESS_KEY=YOUR_R2_SECRET_ACCESS_KEY
R2_BUCKET_NAME=lyricphonics-audio
# Domain public truy cập file nhạc (ví dụ: https://pub-xxxx.r2.dev hoặc để trống để dùng Presigned URL)
R2_PUBLIC_DOMAIN=

# 7. DOMAIN URLS & CORS
# Khi deploy:
# NEXT_PUBLIC_API_URL là địa chỉ Backend API công khai (ví dụ: https://lyricphonics-api.onrender.com)
# FRONTEND_URL là địa chỉ Frontend Next.js (ví dụ: https://lyricphonics.vercel.app)
NEXT_PUBLIC_API_URL=http://localhost:5000
FRONTEND_URL=http://localhost:3000
